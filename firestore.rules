rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'slug', 'price', 'category_id', 'stock_status'])
        && data.name is string && data.name.size() > 0
        && data.price is number && data.price >= 0
        && data.stock_status in ['in_stock', 'low_stock', 'out_of_stock'];
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerName', 'items', 'totalPrice', 'paymentMethod', 'status'])
        && data.customerName is string && data.customerName.size() > 0
        && data.totalPrice is number && data.totalPrice >= 0;
    }

    // ── products ─────────────────────────────────────────────────────
    // Anyone can READ products (public store)
    // Only admins can WRITE products
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(request.resource.data);
      allow update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // ── categories ───────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── orders ───────────────────────────────────────────────────────
    // Any authenticated or guest user can CREATE orders
    // Only admins can READ all orders / UPDATE status / DELETE
    match /orders/{orderId} {
      allow create: if isValidOrder(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // ── reviews ──────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── gallery ──────────────────────────────────────────────────────
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── hero_slides ──────────────────────────────────────────────────
    match /hero_slides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── banners ──────────────────────────────────────────────────────
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── product_banners ──────────────────────────────────────────────
    match /product_banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── settings ─────────────────────────────────────────────────────
    // UI settings, delivery settings, etc.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── admins ───────────────────────────────────────────────────────
    // Only admins can read the admins list
    // Only admins can add/remove other admins
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── users (Google OAuth profiles) ────────────────────────────────
    // Users can read/write their own document
    // Admins can read all users
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ── repair_jobs ──────────────────────────────────────────────────
    match /repair_jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── suppliers ────────────────────────────────────────────────────
    match /suppliers/{supplierId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── cash_flow ────────────────────────────────────────────────────
    match /cash_flow/{txId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── notifications ────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Deny everything else ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
